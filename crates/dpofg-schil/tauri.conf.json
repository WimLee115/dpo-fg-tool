{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dpo-fg-tool",
  "version": "0.1.0",
  "identifier": "nl.dpofgtool.app",
  "build": {
    "frontendDist": "../../schil/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../../schil dev",
    "beforeBuildCommand": "pnpm --dir ../../schil bouw"
  },
  "app": {
    "windows": [
      {
        "label": "organisatie",
        "title": "dpo-fg-tool",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icoon.ico", "icons/icoon.png"],
    "copyright": "",
    "category": "Business",
    "shortDescription": "Werkplatform voor de functionaris gegevensbescherming",
    "longDescription": "Lokaal werkend, versleuteld werkplatform voor de functionaris gegevensbescherming."
  }
}
